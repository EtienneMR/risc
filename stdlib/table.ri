# @std/table — table utilities extending @core/table with higher-level operations.
# keys(t) is re-exported from @core/table; values(t) and pairs(t) complement it.
# from(pairs) builds a table from an array of {key, value} two-element tables.
# clone(t) does a shallow copy; clone(t, .deep=true) recursively deep-copies nested tables.
# Useful when you need to transform, inspect, or safely copy the contents of any table.

let core = require("@core/table")
let iter = require("@std/iter")

let module = {
    .raw_keys = core.keys,
}

module.keys = fn(t)
    core.keys(t) |> iter.from
end

module.values = fn(t)
    module.keys(t)
        |> iter.map(fn(k) t[k] end)
end

module.pairs = fn(t)
    module.keys(t)
        |> iter.map(fn(k) {k, t[k]} end)
end

module.from = fn(pairs)
    let t = {}
    for pair in iter.from(pairs) do
        t[pair[0]] = pair[1]
    end
    t
end

module.clone = fn(t, deep = false)
    let result = {}
    for pair in module.pairs(t) do
        let k = pair[0]
        let v = pair[1]
        if deep && type(v) == "table" then
            result[k] = module.clone(v, .deep = true)
        else
            result[k] = v
        end
    end
    result
end

module.pretty_print = fn(t)
    let c = module.pairs(t)
        |> iter.map(fn(pair) "[" + string.from(pair[0]) + "] = " + string.from(pair[1]) end)
        |> fn(iter) string.join(iter, ",\n") end
        |> fn(content) string.indent(content, 2) end
    "{\n" + c + "\n}"
end

module
