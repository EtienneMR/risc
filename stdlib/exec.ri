# @std/exec — process execution utilities, extending @core/exec with shell helpers.
# Re-exports run(cmd, …) and spawn(cmd, …) for running known binaries directly.
# shell(cmd) and shell_spawn(cmd) implement /bin/sh -c routing in Risc, removing the
# need for Rust-side exec.shell; they delegate to run/spawn from @core/exec.
# Use run/spawn for explicit binaries; use shell/shell_spawn for pipelines and builtins.

let core = require("@core/exec")
let os   = require("@core/os")

let module = table.clone(core)

let _shell_argv = fn(cmd)
    if os.platform() == "windows" then
        {"cmd", "/C", cmd}
    else
        {"/bin/sh", "-c", cmd}
    end
end

module.shell = fn(cmd, .env = nil, .cwd = nil)
    let argv = _shell_argv(cmd)
    if env != nil && cwd != nil then
        core.run(argv[0], argv[1], argv[2], .env = env, .cwd = cwd)
    elseif env != nil then
        core.run(argv[0], argv[1], argv[2], .env = env)
    elseif cwd != nil then
        core.run(argv[0], argv[1], argv[2], .cwd = cwd)
    else
        core.run(argv[0], argv[1], argv[2])
    end
end

module.shell_spawn = fn(cmd, .env = nil, .cwd = nil)
    let argv = _shell_argv(cmd)
    if env != nil && cwd != nil then
        core.spawn(argv[0], argv[1], argv[2], .env = env, .cwd = cwd)
    elseif env != nil then
        core.spawn(argv[0], argv[1], argv[2], .env = env)
    elseif cwd != nil then
        core.spawn(argv[0], argv[1], argv[2], .cwd = cwd)
    else
        core.spawn(argv[0], argv[1], argv[2])
    end
end

module
