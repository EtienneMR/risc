# @std/json — JSON file I/O built on @core/json and @core/os.
# Re-exports parse(s) and stringify(v, indent?) from the core module for convenience.
# load(path) reads a UTF-8 file and returns the parsed Risc value tree.
# dump(path, value) and dump(path, value, indent) serialize a value and write it to disk.
# All JSON-to-Risc type mapping rules live in @core/json; see that module for details.

let core = require("@core/json")
let os   = require("@core/os")

let module = table.clone(core)

module.load = fn(path)
    core.parse(os.read(path))
end

module.dump = fn(path, value, indent)
    let text = if indent != nil then
        core.stringify(value, indent)
    else
        core.stringify(value)
    end
    os.write(path, text)
end

module
