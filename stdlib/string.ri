# @std/string — higher-level string utilities, extending @core/string.
# Starts from a clone of @core/string so all core functions are available on this module.
# Splitting: lines() normalises CRLF to LF; words() discards empty tokens after trimming.
# Joining: join(items, sep) converts each element via string.from before concatenating.
# Extras: count(s, needle), is_digits(s), indent(s, n), truncate(s, max, ellipsis).

let core = require("@core/string")
let iter = require("@std/iter")

let module = table.clone(core)

module.lines = fn(s)
    core.split(core.replace(s, "\r\n", "\n"), "\n")
end

module.words = fn(s)
    core.split(core.trim(s), " ")
        |> iter.from
        |> iter.map(fn(w) core.trim(w) end)
        |> iter.filter(fn(w) w != "" end)
        |> iter.collect()
end

module.join = fn(items, sep)
    iter.from(items)
        |> iter.map(fn(item) core.from(item) end)
        |> iter.reduce(fn(a, b) a + sep + b end, .default = "")
end

module.count = fn(s, needle)
    if needle == "" then return 0 end
    len(core.split(s, needle)) - 1
end

module.is_digits = fn(s)
    if s == "" then return false end
    let digits = "0123456789"
    iter.from(core.split(s, ""))
        |> iter.filter(fn(ch) ch != "" end)
        |> iter.all(fn(ch) core.find(digits, ch) != nil end)
end

module.indent = fn(s, n)
    let prefix = core.repeat(" ", n)
    module.lines(s)
        |> iter.from
        |> iter.map(fn(line) prefix + line end)
        |> iter.reduce(fn(a, b) a + "\n" + b end)
end

module.truncate = fn(s, max_len, ellipsis)
    if ellipsis == nil then ellipsis = "..." end
    if core.len(s) <= max_len then
        s
    else
        core.slice(s, 0, max_len - core.len(ellipsis)) + ellipsis
    end
end

module
