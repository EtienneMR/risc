# @std/utf8 — Unicode string utilities built on @core/utf8 and @std/iter.
# chars(s) returns a lazy iterator over each Unicode character in a string.
# enum_chars(s) yields {i, char} pairs; is_ascii(s) tests for pure ASCII content.
# filter_chars(s, f) rebuilds a string keeping only characters where f(char) is truthy.
# to_hex(s) encodes all bytes as a lowercase hex string; delegates encoding to @core/utf8.

let core = require("@core/utf8")
let iter = require("@std/iter")
let str  = require("@core/string")

let module = table.clone(core)

module.chars = fn(s)
    let points = core.codepoints(s)
    let n      = len(points)
    let i      = 0
    fn()
        if i < n then
            let c = core.char(points[i])
            i = i + 1
            c
        end
    end
end

module.enum_chars = fn(s)
    let points = core.codepoints(s)
    let n      = len(points)
    let i      = 0
    fn()
        if i < n then
            let pair = { .i = i, .char = core.char(points[i]) }
            i = i + 1
            pair
        end
    end
end

module.is_ascii = fn(s)
    core.codepoints(s)
        |> iter.from
        |> iter.all(fn(cp) cp <= 127 end)
end

module.filter_chars = fn(s, f)
    let points = core.codepoints(s)
    let kept = points
        |> iter.from
        |> iter.filter(fn(cp) f(core.char(cp)) end)
        |> iter.collect
    core.from_codepoints(kept)
end

module.to_hex = fn(s)
    let bytes = core.encode(s)
    let hex   = "0123456789abcdef"
    bytes
        |> iter.from
        |> iter.map(fn(b)
            let lo = b % 16
            let hi = (b - lo) / 16
            str.char_at(hex, hi) + str.char_at(hex, lo)
        end)
        |> iter.fold("", fn(acc, pair) acc + pair end)
end

module
