# @std/iter — lazy iterator library for composing data transformation pipelines.
# An iterator is any zero-argument function returning successive values and nil when done.
# Source factories: from(table), range(n), count(start,step), repeat(v), once(v).
# Combinators (map, filter, take, skip, zip, chain, enumerate, flatten, chunk) are curried.
# Terminal sinks: collect(), fold(init,f), reduce(f), any(pred), all(pred).

let module = {}

module.from = fn(t)
    if type(t) == "function" then
        return t
    elseif type(t) == "table" then
        let i = 0
        fn()
            let v = t[i]
            i = i + 1
            v
        end
    else
        error("type error", "cannot convert " + type(t) + " to iter")
    end
end

module.count = fn(start = 0, step = 1)
    fn()
        let v = start
        start = start + step
        v
    end
end

module.range = fn(start, stop = nil, step = 1)
    let cur = if stop == nil then
        stop = start
        0
    else
        start
    end
    fn()
        if
            if step > 0 then cur < stop else cur > stop end
        then
            let v = cur
            cur = cur + step
            v
        end
    end
end

module.repeat = fn(v, n = nil)
    let count = 0
    fn()
        if n == nil || count < n then
            count = count + 1
            v
        end
    end
end

module.once = fn(v)
    let done = false
    fn()
        if !done then
            done = true
            v
        end
    end
end

module.map = fn(f)
    fn(iter)
        fn()
            for v in iter do
                return f(v)
            end
        end
    end
end

module.filter = fn(pred)
    fn(iter)
        fn()
            for v in iter do
                if pred(v) then return v end
            end
        end
    end
end

module.collect = fn()
    fn(iter)
        iter
        |> module.fold({}, fn(t, v)
            t[len(t)] = v
            t
        end)
    end
end

module.fold = fn(init, f)
    fn(iter)
        let acc = init
        for v in iter do
            acc = f(acc, v)
        end
        acc
    end
end

module.reduce = fn(f, default = nil)
    fn(iter)
        let acc = iter()
        if acc == nil then return default end
        iter |> module.fold(acc, f)
    end
end

module.take = fn(n)
    fn(iter)
        let count = 0
        fn()
            if count < n then
                let v = iter()
                if v != nil then
                    count = count + 1
                    v
                end
            end
        end
    end
end

module.take_while = fn(pred)
    fn(iter)
        let done = false
        fn()
            if !done then
                let v = iter()
                if v != nil && pred(v) then
                    v
                else
                    done = true
                    nil
                end
            end
        end
    end
end

module.skip = fn(n)
    fn(iter)
        let primed = false
        fn()
            if !primed then
                primed = true
                for _ in module.range(n) do
                    iter()
                end
            end
            iter()
        end
    end
end

module.skip_while = fn(pred)
    fn(iter)
        let skipping = true
        fn()
            while skipping do
                let v = iter()
                if v == nil then return nil end
                if !pred(v) then
                    skipping = false
                    return v
                end
            end
            iter()
        end
    end
end

module.enumerate = fn()
    fn(iter)
        module.count() |> module.zip(iter)
    end
end

module.any = fn(pred)
    fn(iter)
        for v in iter do
            if pred(v) then return true end
        end
        false
    end
end

module.all = fn(pred)
    fn(iter)
        for v in iter do
            if !pred(v) then return false end
        end
        true
    end
end

module.zip = fn(iter_b)
    fn(iter_a)
        fn()
            let a = iter_a()
            let b = iter_b()
            if a != nil && b != nil then {a, b} end
        end
    end
end

module.chain = fn(iter_b)
    iter_b = iter.from(iter_b)
    fn(iter_a)
        iter_a = iter.from(iter_a)
        let on_b = false
        fn()
            if !on_b then
                let v = iter_a()
                if v != nil then return v end
                on_b = true
            end
            iter_b()
        end
    end
end

module.flatten = fn()
    fn(outer)
        let inner = nil
        fn()
            while true do
                if inner != nil then
                    let v = inner()
                    if v != nil then return v end
                    inner = nil
                end
                inner = outer()
                if inner == nil then return nil end
            end
        end
    end
end

module.chunk = fn(n)
    fn(iter)
        let done = false
        fn()
            if done then return nil end
            let part = iter |> module.take(n) |> module.collect()
            if len(part) == 0 then
                done = true
                return nil
            end
            if len(part) < n then done = true end
            part
        end
    end
end

module
