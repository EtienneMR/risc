# @std/regex — regular expression search and replacement, built on @core/regex.
# Re-exports all core functions: test, find, find_all, captures, replace, replace_all, split.
# scan_all(pat, s) returns a table of matched text strings without position metadata.
# scan_group(pat, s) collects every first capture group across all non-overlapping matches.
# Patterns use RE2 syntax (regex-lite); no backreferences or Unicode property classes.

let core = require("@core/regex")
let str  = require("@core/string")
let iter = require("@std/iter")

let module = table.clone(core)

module.scan_all = fn(pattern, s)
    core.find_all(pattern, s)
        |> iter.from
        |> iter.map(fn(m) m["text"] end)
        |> iter.collect
end

module.scan_group = fn(pattern, input)
    let result  = {}
    let ri      = 0
    let source  = input
    while true do
        let caps = core.captures(pattern, source)
        if caps == nil then break end
        if caps[1] != nil then
            result[ri] = caps[1]
            ri = ri + 1
        end
        let pos = str.find(source, caps[0])
        if pos == nil then break end
        source = str.slice(source, pos + str.len(caps[0]), str.len(source))
    end
    result
end

module
