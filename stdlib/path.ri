# @std/path — path manipulation: decomposition, normalisation, and OS-aware joins.
# Pure string functions (basename, dirname, ext, stem, split, normalize) work on "/" separators.
# Filesystem functions (join, absolute, is_absolute) are re-exported from @core/path.
# normalize resolves . and .. components without touching the filesystem.
# Backslash separators are unified to "/" before any decomposition occurs.

let core = require("@core/path")
let s    = require("@core/string")
let iter = require("@std/iter")

let module = table.clone(core)

let fn unify_sep(p)
    s.replace(p, "\\", "/")
end

let fn last_sep(p)
    let rev = s.reverse(p)
    let pos = s.find(rev, "/")
    if pos == nil then nil
    else s.len(p) - pos - 1
    end
end

let fn strip_trailing_sep(p)
    let n = s.len(p)
    if n > 1 && s.char_at(p, n - 1) == "/" then
        s.slice(p, 0, n - 1)
    else
        p
    end
end

module.basename = fn(p)
    let p2 = strip_trailing_sep(unify_sep(p))
    let sep_pos = last_sep(p2)
    if sep_pos == nil then p2
    else s.slice(p2, sep_pos + 1, s.len(p2))
    end
end

module.dirname = fn(p)
    let p2 = strip_trailing_sep(unify_sep(p))
    let sep_pos = last_sep(p2)
    if sep_pos == nil then ""
    elseif sep_pos == 0 then "/"
    else s.slice(p2, 0, sep_pos)
    end
end

let fn dot_split(base)
    let searchable = if s.len(base) > 0 && s.char_at(base, 0) == "." then
        s.slice(base, 1, s.len(base))
    else
        base
    end
    let rev     = s.reverse(searchable)
    let dot_pos = s.find(rev, ".")
    if dot_pos == nil || dot_pos == 0 then
        {.stem = base, .ext = nil, .has_leading_dot = searchable != base}
    else
        let base_len  = s.len(searchable)
        let last_dot  = base_len - dot_pos - 1
        let prefix    = if searchable != base then "." else "" end
        {
            .stem            = prefix + s.slice(searchable, 0, last_dot),
            .ext             = s.slice(searchable, last_dot + 1, base_len),
            .has_leading_dot = searchable != base,
        }
    end
end

module.ext = fn(p)
    dot_split(module.basename(p)).ext
end

module.stem = fn(p)
    dot_split(module.basename(p)).stem
end

module.split = fn(p)
    { .dir = module.dirname(p), .base = module.basename(p) }
end

module.normalize = fn(p)
    let unified = unify_sep(p)
    let is_abs  = s.starts_with(unified, "/")
    let parts   = s.split(unified, "/")

    let stack = {}
    let depth = 0
    for comp in iter.from(parts) do
        if comp == ".." then
            if depth > 0 then
                depth = depth - 1
            elseif !is_abs then
                stack[depth] = ".."
                depth = depth + 1
            end
        elseif comp != "." && comp != "" then
            stack[depth] = comp
            depth = depth + 1
        end
    end

    let result = iter.range(depth)
        |> iter.map(fn(j) "/" + stack[j] end)
        |> iter.fold("", fn(acc, seg) acc + seg end)

    if is_abs then
        if result == "" then "/" else result end
    else
        if result == "" then "." else s.slice(result, 1, s.len(result)) end
    end
end

module
