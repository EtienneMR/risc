let json = require("@core/json")
let string = require("@core/string")

# parse scalars
assert(json.parse("null")  == nil,   "null")
assert(json.parse("true")  == true,  "true")
assert(json.parse("false") == false, "false")
assert(json.parse("42")    == 42,    "number")
assert(json.parse("3.14")  == 3.14,  "float")
assert(json.parse("\"hi\"") == "hi", "string")
print("json.parse scalars: ok")

# parse array
let arr = json.parse("[1,2,3]")
assert(arr[0] == 1, "array[0]")
assert(arr[1] == 2, "array[1]")
assert(arr[2] == 3, "array[2]")
print("json.parse array: ok")

# parse object
let obj = json.parse("{\"x\":10,\"y\":20}")
assert(obj["x"] == 10, "object x")
assert(obj["y"] == 20, "object y")
print("json.parse object: ok")

# parse nested
let nested = json.parse("{\"a\":[1,{\"b\":true}]}")
assert(nested["a"][1]["b"] == true, "nested")
print("json.parse nested: ok")

# stringify round-trip
let data = json.parse(json.stringify(arr))
assert(data[0] == 1 && data[2] == 3, "stringify/parse round-trip")
print("json.stringify round-trip: ok")

# stringify with indent produces a string
let pretty = json.stringify(obj, 2)
assert(type(pretty) == "string", "pretty is string")
assert(string.contains(pretty, "\n"), "pretty has newlines")
print("json.stringify indent: ok")

print("all json tests passed")
