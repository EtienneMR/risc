let safe_div = fn(a, b)
    if b == 0 then
        return error("math error", "division by zero")
    end
    a / b
end

# try/catch: typed catch
let caught_kind = nil
try
    safe_div(1, 0)
catch "math error" as e
    caught_kind = e.message
catch as e
    print(e)
    caught_kind = "fallback"
end
assert(caught_kind == "division by zero")
print("typed catch: ok")

# try/catch: catch-all
let caught = nil
try
    error("some error", "oops")
catch as e
    caught = e.message
end
assert(caught == "oops")
print("catch-all: ok")

# try/catch: else branch runs when no error
let ran_else = false
try
    let x = 1 + 1
catch as e
    ran_else = false
else
    ran_else = true
end
assert(ran_else)
print("else branch: ok")

# try/catch: no matching arm re-propagates
let outer_caught = nil
try
    try
        error("inner", "inner message")
    catch "other" as e
        outer_caught = "wrong"
    end
catch "inner" as e
    outer_caught = e.message
end
assert(outer_caught == "inner message")
print("re-propagation: ok")

# try/catch: non-error signals pass through
let loop_val = 0
while true do
    try
        loop_val = loop_val + 1
        if loop_val == 3 then
            break nil
        end
    catch as e
        loop_val = -1
    end
end
assert(loop_val == 3)
print("break passes through try: ok")

#try/catch: value pass through
let try_result = try
    1
end
assert(try_result == 1)

let catch_result = try
    error("oops")
catch as e
    e.error + " error"
end
assert(catch_result == "oops error")

let else_result = try
    1
else
    2
end
assert(else_result == 2)
print("values passes through try/catch/else: ok")

print("all error tests passed")
