let test = require("@std/test")
let cli  = require("@std/cli")

cli.pos("name", "Your name")
cli.pos("required", "Must be here")
cli.pos("port", "Port number", 8080)
cli.flag("verbose", "v", "Verbose mode")
cli.rest("others", "Other args")

test.suite("@std/cli", fn()
    test.it("parse simple args", fn()
        let opts = cli.parse({"prog", "alice", "val", "-v", "80", "extra1", "extra2"})
        test.check_eq(opts.name, "alice", "pos name")
        test.check_eq(opts.required, "val", "pos required")
        test.check_eq(opts.verbose, true, "flag verbose")
        test.check_eq(len(opts.others), 2, "rest length")
        test.check_eq(opts.others[0], "extra1", "rest[0]")
    end)

    test.it("parse defaults", fn()
        let opts = cli.parse({"prog", "alice", "val"})
        test.check_eq(opts.port, 8080, "default port")
    end)

    test.it("missing required arg", fn()
        test.assert_raises("argument error", fn()
            cli.parse({"prog", "alice"})
        end)
    end)
end)
