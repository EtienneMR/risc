1 && 2

let fn range(i)
    let c = 0
    fn()
        if c < i then
            c = c + 1
        end
    end
end

let fn zip(b)
    fn(a)
        fn()
            if (let va = a()) != nil && (let vb = b()) != nil then
                {
                    .a = va,
                    .b = vb,
                }
            else
                nil
            end
        end
    end
end

let fn map(t)
    fn(f)
        fn()
            if (let v = f()) != nil then
                t(v)
            end
        end
    end
end

let fn take(n)
    fn(f)
        f
        |> zip(range(n))
        |> map(fn(v) v.a end)
    end
end

let take10 = take(10)

for n in range(100) |> take10 do
    print(n)
end
