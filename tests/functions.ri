let test = require("@std/test")

test.suite("functions", fn()
    test.it("basic closure", fn()
        let make_adder = fn(x)
            fn(y) x + y end
        end
        let add5 = make_adder(5)
        test.assert_eq(add5(10), 15, "5 + 10 = 15")
    end)

    test.it("nested scope / shadowing", fn()
        let x = 10
        let inner = fn()
            let x = 20
            x
        end
        test.assert_eq(inner(), 20, "shadowed x")
        test.assert_eq(x, 10, "outer x remains")
    end)

    test.it("rest parameters", fn()
        let sum_all = fn(..args)
            let s = 0
            for v in iter.from(args) do
                s = s + v
            end
            s
        end
        test.assert_eq(sum_all(1, 2, 3), 6, "sum 1,2,3")
        test.assert_eq(sum_all(), 0, "sum empty")
        test.assert_eq(sum_all(10), 10, "sum single")
    end)

    test.it("recursion", fn()
        let fact = fn(n)
            if n <= 1 then 1
            else n * fact(n - 1)
            end
        end
        test.assert_eq(fact(5), 120, "factorial 5")
    end)
end)
