# TODO
return nil

let fs = require("@std/fs")

# Write a test file
let w = fs.create("_test_output.txt")!
w.write("hello\n")
w.write("world\n")
w.write("goodbye")
w.close()
print("write: ok")

# Read back byte-by-byte, count bytes
let reader = fs.open("_test_output.txt")!
let count = 0
for byte in reader.bytes do
    count = count + 1
end
# "hello\n" (6) + "world\n" (6) + "goodbye" (7) = 19
assert(count == 19, "expected 19 bytes, got " + string.from(count))
print("byte iterator: ok, " + string.from(count) + " bytes")

# Read lines via toUTF8
let reader2 = fs.open("_test_output.txt")!
let line0 = nil
let line1 = nil
let line2 = nil
let line_n = 0
for line in toUTF8(reader2.bytes) do
    if line_n == 0 then line0 = line end
    if line_n == 1 then line1 = line end
    if line_n == 2 then line2 = line end
    line_n = line_n + 1
end
assert(line_n == 3, "expected 3 lines, got " + string.from(line_n))
assert(line0 == "hello", "expected 'hello', got " + string.from(line0))
assert(line1 == "world")
assert(line2 == "goodbye")
print("toUTF8: ok")

# fs.exists
assert(fs.exists("_test_output.txt") == true)
assert(fs.exists("_nonexistent_xyz.txt") == false)
print("exists: ok")

# fs.append
let a = fs.append("_test_output.txt")!
a.write("\nappended")
a.close()
let reader3 = fs.open("_test_output.txt")!
let last_line = nil
for line in toUTF8(reader3.bytes) do
    last_line = line
end
assert(last_line == "appended", "expected 'appended', got " + string.from(last_line))
print("append: ok")

# Repeated writes without close are fine
let w2 = fs.create("_test_output.txt")!
let i = 0
while i < 5 do
    w2.write("line " + string.from(i) + "\n")
    i = i + 1
end
w2.close()
let lcount = 0
let r4 = fs.open("_test_output.txt")!
for line in toUTF8(r4.bytes) do
    lcount = lcount + 1
end
assert(lcount == 5, "expected 5 lines from repeated write, got " + string.from(lcount))
print("repeated write: ok")

# Write bytes by number
let w3 = fs.create("_test_output.txt")!
w3.write(65)   # 'A'
w3.write(66)   # 'B'
w3.write(10)   # '\n'
w3.close()
let r5 = fs.open("_test_output.txt")!
let byte_line = nil
for line in toUTF8(r5.bytes) do
    byte_line = line
end
assert(byte_line == "AB", "expected 'AB', got " + string.from(byte_line))
print("byte write: ok")

# Error handling: open non-existent file
let open_err = nil
try
    fs.open("_no_such_file_xyz.txt")
catch "IOError" as e
    open_err = e.error
end
assert(open_err == "IOError")
print("IOError catch: ok")

# Cleanup
fs.remove("_test_output.txt")
assert(fs.exists("_test_output.txt") == false)
print("remove: ok")

print("all fs tests passed")
