let safe_div = fn(a, b)
    if b == 0 do
        return error("division by zero", "MathError")
    end
    a / b
end

-- try/catch: typed catch
let caught_kind = nil
try
    safe_div(1, 0)
catch "MathError" as e
    caught_kind = e.error
catch as e
    print(e)
    caught_kind = "fallback"
end
assert(caught_kind == "MathError")
print("typed catch: ok")

-- try/catch: catch-all
let caught = nil
try
    error("oops", "SomeError")
catch as e
    caught = e.msg
end
assert(caught == "oops")
print("catch-all: ok")

-- try/catch: else branch runs when no error
let ran_else = false
try
    let x = 1 + 1
catch as e
    ran_else = false
else
    ran_else = true
end
assert(ran_else)
print("else branch: ok")

-- try/catch: no matching arm re-propagates
let outer_caught = nil
try
    try
        error("inner", "Inner")
    catch "Other" as e
        outer_caught = "wrong"
    end
catch "Inner" as e
    outer_caught = e.msg
end
assert(outer_caught == "inner")
print("re-propagation: ok")

-- try/catch: non-error signals pass through
let loop_val = 0
while true do
    try
        loop_val = loop_val + 1
        if loop_val == 3 do
            break
        end
    catch as e
        loop_val = -1
    end
end
assert(loop_val == 3)
print("break passes through try: ok")

--try/catch: value pass through
let try_result = try
    1
end
assert(try_result == 1)

let catch_result = try
    error("oops")
catch as e
    e.msg + " error"
end
assert(catch_result == "oops error")

let else_result = try
    1
else
    2
end
assert(else_result == 2)
print("values passes through try/catch/else: ok")

print("all error tests passed")
