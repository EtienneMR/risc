let test = require("@std/test")
let re   = require("@std/regex")

test.suite("@std/regex", fn()
    test.it("scan_all", fn()
        let matches = re.scan_all("a+b+", "aaabbcccc ddeeff")
        test.check_eq(len(matches), 1, "one match")
        test.check_eq(matches[0], "aaabb", "match text")
    end)

    test.it("scan_group", fn()
        let groups = re.scan_group("id:(\\d+)", "id:123, id:456")
        test.check_eq(len(groups), 2, "two groups")
        test.check_eq(groups[0], "123", "group 1")
        test.check_eq(groups[1], "456", "group 2")
    end)
end)
