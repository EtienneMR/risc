# test break
let i = 0
while i < 10 do
    i = i + 1
    if i == 5 then
        break nil
    end
end
assert(i == 5, "break should stop at 5")
print("break: ok, i =", i)

# test continue
let sum = 0
let j = 0
while j < 10 do
    j = j + 1
    if j % 2 == 0 then
        continue
    end
    sum = sum + j
end
assert(sum == 25, "continue should skip evens")
print("continue: ok, sum =", sum)

# test return
let add = fn(a, b)
    return a + b
    print("unreachable")
end
let result = add(3, 4)
assert(result == 7, "return should yield 7")
print("return: ok, result =", result)

# test return nil
let early = fn(x)
    if x < 0 then
        return nil
    end
    x * 2
end
assert(early(-1) == nil, "early return should give nil")
assert(early(3) == 6, "no return should give last expr")
print("early return: ok")

print("all control flow tests passed")

return true
