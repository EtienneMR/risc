let test = require("@std/test")
let it   = require("@std/iter")

test.suite("@std/iter", fn()
    test.suite("@std/iter sources", fn()
        test.it("from — table", fn()
            let result = it.from({10, 20, 30}) |> it.collect
            test.assert_eq(result[0], 10, "from table [0]")
            test.assert_eq(result[1], 20, "from table [1]")
            test.assert_eq(result[2], 30, "from table [2]")
        end)

        test.it("from — iterator passthrough", fn()
            let src = it.range(3)
            let same = it.from(src)
            test.assert_eq(same(), 0, "passthrough [0]")
            test.assert_eq(same(), 1, "passthrough [1]")
        end)

        test.it("from — type error", fn()
            test.assert_raises("type error", fn()
                it.from(42)
            end)
        end)

        test.it("range — single arg (0..n)", fn()
            let result = it.range(4) |> it.collect
            test.assert_eq(len(result), 4,  "range length")
            test.assert_eq(result[0],   0,  "range[0]")
            test.assert_eq(result[3],   3,  "range[3]")
        end)

        test.it("range — start/stop", fn()
            let result = it.range(2, 5) |> it.collect
            test.assert_eq(result[0], 2, "range(2,5)[0]")
            test.assert_eq(result[2], 4, "range(2,5)[2]")
            test.assert_eq(len(result), 3, "range(2,5) length")
        end)

        test.it("range — step", fn()
            let result = it.range(0, 10, 3) |> it.collect
            test.assert_eq(result[0], 0, "step[0]")
            test.assert_eq(result[1], 3, "step[1]")
            test.assert_eq(result[2], 6, "step[2]")
            test.assert_eq(result[3], 9, "step[3]")
            test.assert_eq(len(result), 4, "step length")
        end)

        test.it("range — descending", fn()
            let result = it.range(5, 0, -1) |> it.collect
            test.assert_eq(result[0], 5, "desc[0]")
            test.assert_eq(result[4], 1, "desc[4]")
        end)

        test.it("count", fn()
            let c = it.count(0, 5)
            test.assert_eq(c(), 0,  "count 0")
            test.assert_eq(c(), 5,  "count 5")
            test.assert_eq(c(), 10, "count 10")
        end)

        test.it("repeat — infinite", fn()
            let r = it.repeat("x")
            test.assert_eq(r(), "x", "repeat 1")
            test.assert_eq(r(), "x", "repeat 2")
            test.assert_eq(r(), "x", "repeat 3")
        end)

        test.it("repeat — bounded", fn()
            let result = it.repeat("y", 3) |> it.collect
            test.assert_eq(len(result), 3,   "bounded repeat length")
            test.assert_eq(result[0],   "y", "bounded repeat[0]")
        end)

        test.it("once", fn()
            let o = it.once(42)
            test.assert_eq(o(), 42,  "once first call")
            test.assert_eq(o(), nil, "once exhausted")
        end)
    end)

    test.suite("@std/iter combinators", fn()
        test.it("map", fn()
            let result = it.from({1, 2, 3})
                |> it.map(fn(x) x * 2 end)
                |> it.collect
            test.assert_eq(result[0], 2, "map[0]")
            test.assert_eq(result[1], 4, "map[1]")
            test.assert_eq(result[2], 6, "map[2]")
        end)

        test.it("filter", fn()
            let result = it.from({1, 2, 3, 4, 5})
                |> it.filter(fn(x) x % 2 == 0 end)
                |> it.collect
            test.assert_eq(len(result), 2,  "filter count")
            test.assert_eq(result[0],   2,  "filter[0]")
            test.assert_eq(result[1],   4,  "filter[1]")
        end)

        test.it("take", fn()
            let result = it.range(100) |> it.take(3) |> it.collect
            test.assert_eq(len(result), 3, "take length")
            test.assert_eq(result[2],   2, "take[2]")
        end)

        test.it("skip", fn()
            let result = it.range(5) |> it.skip(2) |> it.collect
            test.assert_eq(len(result), 3, "skip length")
            test.assert_eq(result[0],   2, "skip[0] = 2")
        end)

        test.it("take_while", fn()
            let result = it.from({1, 2, 3, 4, 5})
                |> it.take_while(fn(x) x < 4 end)
                |> it.collect
            test.assert_eq(len(result), 3, "take_while length")
            test.assert_eq(result[2],   3, "take_while last")
        end)

        test.it("skip_while", fn()
            let result = it.from({1, 2, 3, 4})
                |> it.skip_while(fn(x) x < 3 end)
                |> it.collect
            test.assert_eq(len(result), 2, "skip_while length")
            test.assert_eq(result[0],   3, "skip_while[0]")
        end)

        test.it("enumerate — yields {i, v} pairs", fn()
            let result = it.from({"a", "b", "c"})
                |> it.enumerate
                |> it.collect
            test.assert_eq(result[0][0], 0,   "enum index 0")
            test.assert_eq(result[0][1], "a", "enum value a")
            test.assert_eq(result[2][0], 2,   "enum index 2")
            test.assert_eq(result[2][1], "c", "enum value c")
        end)

        test.it("zip", fn()
            let result = it.from({1, 2, 3})
                |> it.zip(it.from({"a", "b", "c"}))
                |> it.collect
            test.assert_eq(result[0][0], 1,   "zip[0][0]")
            test.assert_eq(result[0][1], "a", "zip[0][1]")
            test.assert_eq(result[2][0], 3,   "zip[2][0]")
        end)

        test.it("zip — stops at shortest", fn()
            let result = it.range(5) |> it.zip(it.range(3)) |> it.collect
            test.assert_eq(len(result), 3, "zip stops at shorter")
        end)

        test.it("chain", fn()
            let result = it.from({1, 2})
                |> it.chain(it.from({3, 4}))
                |> it.collect
            test.assert_eq(len(result), 4, "chain length")
            test.assert_eq(result[2],   3, "chain[2]")
        end)

        test.it("flatten", fn()
            let nested = it.from({
                it.from({1, 2}),
                it.from({3, 4}),
            })
            let result = nested |> it.flatten |> it.collect
            test.assert_eq(len(result), 4, "flatten length")
            test.assert_eq(result[0],   1, "flatten[0]")
            test.assert_eq(result[3],   4, "flatten[3]")
        end)

        test.it("chunk", fn()
            let result = it.range(7) |> it.chunk(3) |> it.collect
            test.assert_eq(len(result),    3, "chunk count")
            test.assert_eq(len(result[0]), 3, "first chunk size")
            test.assert_eq(len(result[2]), 1, "last chunk size (remainder)")
            test.assert_eq(result[0][0],   0, "chunk[0][0]")
            test.assert_eq(result[1][0],   3, "chunk[1][0]")
            test.assert_eq(result[2][0],   6, "chunk[2][0]")
        end)
    end)

    test.suite("@std/iter sinks", fn()
        test.it("fold", fn()
            let sum = it.range(5) |> it.fold(0, fn(acc, v) acc + v end)
            test.assert_eq(sum, 10, "fold sum 0..4")
        end)

        test.it("reduce", fn()
            let product = it.from({1, 2, 3, 4})
                |> it.reduce(fn(a, b) a * b end)
            test.assert_eq(product, 24, "reduce product")
        end)

        test.it("reduce — empty with default", fn()
            let r = it.from({}) |> it.reduce(fn(a, b) a + b end, .default = 0)
            test.assert_eq(r, 0, "reduce empty default")
        end)

        test.it("any", fn()
            test.assert_eq(
                it.from({1, 3, 5, 6}) |> it.any(fn(x) x % 2 == 0 end),
                true, "any found even")
            test.assert_eq(
                it.from({1, 3, 5}) |> it.any(fn(x) x % 2 == 0 end),
                false, "any no even")
        end)

        test.it("all", fn()
            test.assert_eq(
                it.from({2, 4, 6}) |> it.all(fn(x) x % 2 == 0 end),
                true, "all even")
            test.assert_eq(
                it.from({2, 4, 5}) |> it.all(fn(x) x % 2 == 0 end),
                false, "all not all even")
        end)
    end)
end)
