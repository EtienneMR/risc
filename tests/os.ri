let os   = require("@core/os")
let path = require("@core/path")
let test = require("@std/test")

# ── helpers ──────────────────────────────────────────────────────────────────

let tmp = path.join(os.cwd(), "_risc_fs_test")

let fn cleanup()
    if os.exists(tmp) then
        os.rmdir(tmp, true)
    end
end

let fn tmpfile(name)
    path.join(tmp, name)
end

cleanup()
os.mkdir(tmp, true)

let hello_file = tmpfile("hello.txt")

test.case("files", fn()
    test.case("read / write", fn()
        os.write(hello_file, "hello, risc")
        test.check_eq(os.read(hello_file), "hello, risc", "read after write")
    end)

    test.case("overwrite", fn()
        os.write(hello_file, "overwritten")
        test.check_eq(os.read(hello_file), "overwritten", "overwrite")
    end)

    test.case("append", fn()
        let f = tmpfile("append.txt")
        os.write(f, "line1\n")
        os.append(f, "line2\n")
        os.append(f, "line3\n")
        test.check_eq(os.read(f), "line1\nline2\nline3\n", "append")
    end)
end)

test.case("fs", fn()
    test.case("exists", fn()
        test.check(os.exists(hello_file), "exists true")
        test.check(!os.exists(tmpfile("no_such_file.txt")), "exists false")
    end)

    test.case("stat", fn()
        let st = os.stat(hello_file)
        test.check(st.is_file, "stat is_file")
        test.check(!st.is_dir, "stat not dir")
        test.check(st.size > 0, "stat size > 0")
        test.check(st.modified != nil, "stat modified")
    end)

    test.case("copy", fn()
        let f3 = tmpfile("copy.txt")
        os.copy(hello_file, f3)
        test.check(os.exists(f3), "copy exists")
        test.check_eq(os.read(f3), os.read(hello_file), "copy content")
    end)

    test.case("rename", fn()
        let f3 = tmpfile("copy_for_rename.txt")
        let f4 = tmpfile("renamed.txt")

        os.copy(hello_file, f3)
        os.rename(f3, f4)

        test.check(os.exists(f4), "rename dest exists")
        test.check(!os.exists(f3), "rename src gone")
        test.check_eq(os.read(f4), os.read(hello_file), "rename content")
    end)

    test.case("remove", fn()
        os.remove(hello_file)
        test.check(!os.exists(hello_file), "remove file gone")
    end)
end)

test.case("mkdir / rmdir / list", fn()
    let sub = tmpfile("subdir")
    os.mkdir(sub, false)
    test.check(os.exists(sub), "mkdir exists")

    let st2 = os.stat(sub)
    test.check(st2.is_dir, "mkdir is_dir")

    os.write(path.join(sub, "a.txt"), "a")
    os.write(path.join(sub, "b.txt"), "b")

    let entries = os.list(sub, false)
    test.check_eq(len(entries), 2, "list count")
    test.check_eq(entries[0], "a.txt", "list[0]")
    test.check_eq(entries[1], "b.txt", "list[1]")

    let full_entries = os.list(sub, true)
    test.check(
        string.contains(full_entries[0], "/") || string.contains(full_entries[0], "\\"),
        "list full_path contains sep"
    )

    os.remove(path.join(sub, "a.txt"))
    os.remove(path.join(sub, "b.txt"))
    os.rmdir(sub, false)
    test.check(!os.exists(sub), "rmdir gone")
end)

test.case("recursive mkdir / rmdir", fn()
    let deep = path.join(tmp, "a", "b", "c")
    os.mkdir(deep, true)
    test.check(os.exists(deep), "recursive mkdir")

    os.rmdir(path.join(tmp, "a"), true)
    test.check(!os.exists(path.join(tmp, "a")), "recursive rmdir")
end)

test.case("read non-existent raises", fn()
    let caught = false
    try
        os.read(tmpfile("ghost.txt"))
    catch "os error" as _e
        caught = true
    end
    test.check(caught, "read missing raises os error")
end)

test.case("write to nested missing dir raises", fn()
    let caught2 = false
    try
        os.write(path.join(tmp, "no", "dir", "file.txt"), "x")
    catch "os error" as _e
        caught2 = true
    end
    test.check(caught2, "write missing parent raises os error")
end)

test.case("cwd / chdir", fn()
    let original_cwd = os.cwd()
    os.chdir(tmp)
    test.check_eq(os.cwd(), tmp, "chdir")
    os.chdir(original_cwd)
    test.check_eq(os.cwd(), original_cwd, "chdir back")
end)

test.case("cleanup", fn()
    cleanup()
    test.check(!os.exists(tmp), "cleanup complete")
end)

test.done()
