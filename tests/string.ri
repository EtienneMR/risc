let test   = require("@std/test")
let string = require("@std/string")

test.suite("@std/string", fn()
    test.it("from", fn()
        test.assert_eq(string.from(42),    "42",    "number")
        test.assert_eq(string.from(true),  "true",  "bool true")
        test.assert_eq(string.from(false), "false", "bool false")
        test.assert_eq(string.from(nil),   "nil",   "nil")
        test.assert_eq(string.from("hi"),  "hi",    "string passthrough")
    end)

    test.it("upper / lower", fn()
        test.assert_eq(string.upper("hello"), "HELLO", "upper")
        test.assert_eq(string.lower("WORLD"), "world", "lower")
        test.assert_eq(string.upper(""),      "",      "upper empty")
    end)

    test.it("trim variants", fn()
        test.assert_eq(string.trim("  hi  "),       "hi",   "trim both")
        test.assert_eq(string.trim_start("  hi  "), "hi  ", "trim_start")
        test.assert_eq(string.trim_end("  hi  "),   "  hi", "trim_end")
        test.assert_eq(string.trim("nopad"),         "nopad","trim no-op")
    end)

    test.it("split", fn()
        let parts = string.split("a,b,c", ",")
        test.assert_eq(parts[0], "a", "split[0]")
        test.assert_eq(parts[1], "b", "split[1]")
        test.assert_eq(parts[2], "c", "split[2]")
        let single = string.split("hello", ",")
        test.assert_eq(single[0], "hello", "split no sep")
    end)

    test.it("contains / starts_with / ends_with", fn()
        test.assert_eq(string.contains("foobar", "oba"),    true,  "contains true")
        test.assert_eq(string.contains("foobar", "xyz"),    false, "contains false")
        test.assert_eq(string.starts_with("foobar", "foo"), true,  "starts_with true")
        test.assert_eq(string.starts_with("foobar", "bar"), false, "starts_with false")
        test.assert_eq(string.ends_with("foobar", "bar"),   true,  "ends_with true")
        test.assert_eq(string.ends_with("foobar", "foo"),   false, "ends_with false")
    end)

    test.it("find / char_at", fn()
        test.assert_eq(string.find("foobar", "bar"), 3,   "find found")
        test.assert_eq(string.find("foobar", "xyz"), nil, "find not found")
        test.assert_eq(string.char_at("hello", 1),   "e", "char_at")
        test.assert_eq(string.char_at("hello", 0),   "h", "char_at first")
    end)

    test.it("replace / replace_first", fn()
        test.assert_eq(string.replace("aabbaa", "aa", "X"),       "XbbX", "replace all")
        test.assert_eq(string.replace_first("aabbaa", "aa", "X"), "Xbbaa","replace first only")
    end)

    test.it("slice", fn()
        test.assert_eq(string.slice("hello", 1, 3), "el",    "slice mid")
        test.assert_eq(string.slice("hello", 0, 5), "hello", "slice all")
        test.assert_eq(string.slice("hello", 4, 5), "o",     "slice last char")
    end)

    test.it("pad_start / pad_end", fn()
        test.assert_eq(string.pad_start("7", 3, "0"),  "007",   "pad_start")
        test.assert_eq(string.pad_end("hi", 5, "."),   "hi...", "pad_end")
        test.assert_eq(string.pad_start("long", 2, "x"), "long","pad no-op when already wide")
    end)

    test.it("repeat / reverse", fn()
        test.assert_eq(string.repeat("ab", 3), "ababab", "repeat")
        test.assert_eq(string.repeat("x", 0),  "",       "repeat zero")
        test.assert_eq(string.reverse("hello"), "olleh",  "reverse")
        test.assert_eq(string.reverse(""),      "",        "reverse empty")
    end)

    test.it("len", fn()
        test.assert_eq(string.len("hello"), 5, "len ascii")
        test.assert_eq(string.len(""),      0, "len empty")
        test.assert_eq(string.len("café"),  4, "len unicode codepoints")
    end)
    
    test.it("lines — splits on LF and CRLF", fn()
        let ls = string.lines("a\nb\nc")
        test.assert_eq(ls[0], "a", "lines[0]")
        test.assert_eq(ls[1], "b", "lines[1]")
        test.assert_eq(ls[2], "c", "lines[2]")
        let crlf = string.lines("x\r\ny\r\nz")
        test.assert_eq(crlf[0], "x", "crlf[0]")
        test.assert_eq(crlf[2], "z", "crlf[2]")
    end)

    test.it("words — splits on whitespace, drops empties", fn()
        let ws = string.words("  hello   world  ")
        test.assert_eq(ws[0], "hello", "words[0]")
        test.assert_eq(ws[1], "world", "words[1]")
        test.assert_eq(len(ws), 2, "words count")
    end)

    test.it("join", fn()
        test.assert_eq(string.join({"a","b","c"}, ", "), "a, b, c", "join strings")
        test.assert_eq(string.join({1, 2, 3}, "-"),      "1-2-3",   "join numbers")
        test.assert_eq(string.join({}, ","),              "",        "join empty")
    end)

    test.it("count", fn()
        test.assert_eq(string.count("banana", "an"), 2, "count occurrences")
        test.assert_eq(string.count("hello",  "x"),  0, "count absent")
        test.assert_eq(string.count("aaa",    ""),   0, "count empty needle")
    end)

    test.it("is_digits", fn()
        test.assert_eq(string.is_digits("12345"), true,  "digits only")
        test.assert_eq(string.is_digits("12x45"), false, "mixed")
        test.assert_eq(string.is_digits(""),      false, "empty")
    end)

    test.it("indent", fn()
        let indented = string.indent("a\nb", 2)
        test.assert(string.starts_with(indented, "  a"), "first line indented")
        test.assert(string.contains(indented, "\n  b"),  "second line indented")
    end)

    test.it("truncate", fn()
        test.assert_eq(string.truncate("hello world", 8, "..."), "hello...", "truncate with ellipsis")
        test.assert_eq(string.truncate("hi", 10, "..."),          "hi",       "truncate no-op")
        test.assert_eq(string.truncate("hello", 5, "..."),        "hello",    "truncate exact fit")
    end)
end)
