let test = require("@std/test")
let path = require("@std/path")

test.suite("@std/path", fn()
    test.it("basename", fn()
        test.assert_eq(path.basename("/home/user/file.txt"), "file.txt", "standard")
        test.assert_eq(path.basename("file.txt"), "file.txt", "no dir")
        test.assert_eq(path.basename("/home/user/dir/"), "dir", "trailing slash")
    end)

    test.it("dirname", fn()
        test.assert_eq(path.dirname("/home/user/file.txt"), "/home/user", "standard")
        test.assert_eq(path.dirname("file.txt"), "", "no dir")
        test.assert_eq(path.dirname("/file.txt"), "/", "root")
    end)

    test.it("ext / stem", fn()
        test.assert_eq(path.ext("file.tar.gz"), "gz", "ext")
        test.assert_eq(path.stem("file.tar.gz"), "file.tar", "stem")
        test.assert_eq(path.ext(".bashrc"), nil, "hidden file no ext")
        test.assert_eq(path.stem(".bashrc"), ".bashrc", "hidden file stem")
    end)

    test.it("normalize", fn()
        test.assert_eq(path.normalize("/a/b/../c"), "/a/c", "simple dotdot")
        test.assert_eq(path.normalize("a/./b"), "a/b", "simple dot")
        test.assert_eq(path.normalize("a/../../b"), "../b", "leading dotdot")
    end)
end)
