let dict = {
    .a_val = 1,
    .b_val = 2,
}

let mapt = {
    .cool = 1,
    [0] = "cool"
}

let array = {
    "a",
    "b",
    "c",
}

let array2 = array
array2[1] = "z"

let to_print = {
    dict,
    mapt,
    array,
    array2,
}

to_print[2][2] = "gg!"

let fn range(i)
    let c = 0
    fn()
        if c < i then
            c = c + 1
            c - 1
        end
    end
end

let fn at(t)
    fn(k)
        t[k]
    end
end

let fn skip(n)
    fn(f)
        for _ in range(n) do
            if f() == nil then
                return nil
            end
        end
        f
    end
end

let fn map(t)
    fn(f)
        fn()
            if (let v = f()) != nil then
                t(v)
            end
        end
    end
end

let fn iter(array)
    array
    |> len
    |> range
    |> map(at(array))
end

let fn collect(iter)
    let t = {}
    for v in iter do
        t[len(t)] = v
    end
    t
end

let i = 90

for k in range(100) |> skip(90) |> collect |> iter do
    assert(i == k)
    i = i + 1
end
assert(i == 100)

